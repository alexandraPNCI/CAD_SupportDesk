<div class="card shadow-sm mt-3 p-3">

  <h5><%= ticket.title %></h5>
  <p><%= ticket.description %></p>

  <div class="mt-2 d-flex gap-2">

    <% if policy(ticket).update? %>
      <%= link_to "Edit",
          edit_ticket_path(ticket),
          class: "btn btn-sm btn-warning" %>
    <% end %>

    <% if policy(ticket).destroy? %>
      <%= button_to "Delete",
          ticket_path(ticket),
          method: :delete,
          class: "btn btn-sm btn-danger",
          data: { confirm: "Delete this ticket?" } %>
    <% end %>

  </div>
</div>

