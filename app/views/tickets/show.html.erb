<% if current_user.role == "admin" %>
  <div class="mb-3">
    <%= link_to "Analytics Dashboard",
        analytics_path,
        class: "btn btn-primary" %>
  </div>
<% end %>

<!-- Edit / Delete Ticket Buttons (ALWAYS visible when authorized) -->
<div class="mb-3">
  <% if policy(@ticket).update? %>
    <%= link_to "Edit Ticket",
        edit_ticket_path(@ticket),
        class: "btn btn-warning me-2" %>
  <% end %>

  <% if policy(@ticket).destroy? %>
    <%= button_to "Delete Ticket",
        ticket_path(@ticket),
        method: :delete,
        class: "btn btn-danger",
        data: { confirm: "Are you sure you want to delete this ticket?" } %>
  <% end %>
</div>


<!-- Ticket Comments -->
<% if @ticket.comments.any? %>
  <% @ticket.comments.each do |comment| %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <p><%= comment.content %></p>

        <p class="text-muted small">
          By <%= comment.user.email %> • <%= time_ago_in_words(comment.created_at) %> ago
        </p>

        <% if policy(comment).destroy? %>
          <%= button_to "Delete Comment",
              ticket_comment_path(@ticket, comment),
              method: :delete,
              class: "btn btn-sm btn-danger",
              data: { confirm: "Delete this comment?" } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-muted">No comments yet.</p>
<% end %>


<!-- Add New Comment -->
<div class="card shadow-sm mt-4">
  <div class="card-body">
    <h5>Add a Comment</h5>

    <%= form_with(model: [@ticket, Comment.new]) do |f| %>
      <div class="mb-3">
        <%= f.text_area :content, class: "form-control", placeholder: "Write a comment…" %>
      </div>
      <%= f.submit "Post Comment", class: "btn btn-success" %>
    <% end %>
  </div>
</div>
